---
layout: layouts/base.njk
---
{% if home.slides and home.slides.length %}
<section class="hero" aria-roledescription="carousel" aria-label="Fotografije sa puta">
  {% for slide in home.slides %}
  <div class="hero-slide{% if loop.first %} is-active{% endif %}" data-caption="{{ slide.caption }}"{% if not loop.first %} aria-hidden="true"{% endif %}>
    <img src="{{ slide.image }}" alt="{{ slide.alt or slide.caption }}" sizes="100vw"
      {% if loop.first %}loading="eager" fetchpriority="high"{% endif %}
      style="object-position: 50% {{ slide.focus if slide.focus != null else 50 }}%">
  </div>
  {% endfor %}
  <div class="hero-bar">
    {% if home.slides.length > 1 %}
    <div class="hero-dots">
      {% for slide in home.slides %}
      <button class="hero-dot" type="button" aria-label="Fotografija {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>
      {% endfor %}
    </div>
    {% endif %}
    <p class="hero-caption" aria-live="polite">{{ home.slides[0].caption }}</p>
  </div>
</section>
{% endif %}

<section class="intro container">
  <h1 class="page-title">{{ home.heading }}</h1>
  {% for p in home.intro | paragraphs %}
  <p>{{ p }}</p>
  {% endfor %}
  {% if home.quote %}<blockquote class="intro-quote">{{ home.quote }}</blockquote>{% endif %}
</section>

<section class="story-list container" aria-labelledby="putopis">
  <div class="story-list-head">
    <h2 id="putopis" class="section-title">{{ home.listHeading }}</h2>
    <label class="country-filter">
      <span class="visually-hidden">Filtriraj priče po zemlji</span>
      <select id="country-filter">
        <option value="">{{ home.allCountries }}</option>
        {% for country in countries %}
        <option value="{{ country | slugify }}">{{ country }}</option>
        {% endfor %}
      </select>
    </label>
  </div>

  {% for story in collections.stories %}
  <article class="story-card" data-country="{{ story.data.country | slugify }}">
    <a class="story-card-image" href="{{ story.url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ story.data.cover }}" alt="" sizes="(min-width: 820px) 475px, 100vw" style="object-position: {{ story.data.coverFocus | focusPos }}">
    </a>
    <div class="story-card-body">
      <p class="meta"><span>{{ story.data.location }}</span><time datetime="{{ story.date | isoDate }}">{{ story.date | srDate }}</time></p>
      <h3 class="story-card-title"><a href="{{ story.url }}">{{ story.data.title }}</a></h3>
      <p class="story-card-excerpt">{{ story.data.excerpt or (story.content | excerpt) }}</p>
      <a class="read-more" href="{{ story.url }}">{{ home.readMore }}<span class="visually-hidden">: {{ story.data.title }}</span></a>
    </div>
  </article>
  {% else %}
  <p>Uskoro prve priče.</p>
  {% endfor %}
  <p class="no-stories" id="no-stories" role="status" hidden>{{ home.noStories }}</p>
</section>

<script>
  // Hero slideshow: next photo every 5 seconds; the dots jump to a photo.
  // It pauses while the mouse is over the photo or the tab is in the background.
  (() => {
    const slides = document.querySelectorAll(".hero-slide");
    const dots = document.querySelectorAll(".hero-dot");
    const caption = document.querySelector(".hero-caption");
    if (slides.length < 2) return;
    let current = 0, timer;
    const show = (i) => {
      slides[current].classList.remove("is-active");
      slides[current].setAttribute("aria-hidden", "true");
      dots[current].removeAttribute("aria-current");
      current = (i + slides.length) % slides.length;
      slides[current].classList.add("is-active");
      slides[current].removeAttribute("aria-hidden");
      dots[current].setAttribute("aria-current", "true");
      caption.textContent = slides[current].dataset.caption;
    };
    const start = () => { clearInterval(timer); timer = setInterval(() => show(current + 1), 5000); };
    const stop = () => clearInterval(timer);
    dots.forEach((dot, i) => dot.addEventListener("click", () => { show(i); start(); }));
    const hero = document.querySelector(".hero");
    hero.addEventListener("mouseenter", stop);
    hero.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    start();
  })();

  // Shows only the stories from the chosen country. The choice is kept in the address (?zemlja=peru),
  // so a filtered list can be shared as a link.
  (() => {
    const select = document.getElementById("country-filter");
    const cards = document.querySelectorAll(".story-card");
    const empty = document.getElementById("no-stories");
    const apply = () => {
      let shown = 0;
      cards.forEach((card) => {
        const match = !select.value || card.dataset.country === select.value;
        card.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
    };
    const fromUrl = new URLSearchParams(location.search).get("zemlja");
    if (fromUrl && select.querySelector(`option[value="${CSS.escape(fromUrl)}"]`)) select.value = fromUrl;
    select.addEventListener("change", () => {
      const url = new URL(location.href);
      if (select.value) url.searchParams.set("zemlja", select.value);
      else url.searchParams.delete("zemlja");
      history.replaceState(null, "", url);
      apply();
    });
    apply();
  })();
</script>
