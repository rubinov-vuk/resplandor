---
layout: layouts/base.njk
---
{# One photo, with the choices made per photo in Pages CMS:
   layout (full, wide, screen, half, small), shape (crop to a ratio), focus (which part stays) and zoom. #}
{% macro photo(item, fallbackAlt) %}
  {% set layout = item.layout or "full" %}
  {% set shape = item.shape or "original" %}
  {% set pos = item.focus | focusPos %}
  {% set zoom = (item.zoom or 1) | float %}
  <figure class="story-photo story-photo--{{ layout }} shape--{{ shape }}">
    <div class="photo-frame">
      <img src="{{ item.image }}" alt="{{ item.caption or fallbackAlt }}"
        {% if layout == "screen" %}sizes="100vw"{% elif layout == "wide" %}sizes="(min-width: 1440px) 1090px, 100vw"{% elif layout == "half" %}sizes="(min-width: 820px) 410px, 100vw"{% endif %}
        style="object-position: {{ pos }};{% if zoom > 1 %} transform: scale({{ zoom }}); transform-origin: {{ pos }};{% endif %}">
    </div>
    {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
  </figure>
{% endmacro %}

<article class="story container-narrow">
  <h1 class="story-title">{{ title }}</h1>
  <p class="meta"><span>{{ location }}</span><time datetime="{{ page.date | isoDate }}">{{ page.date | srDate }}</time></p>

  <div class="story-body">
    {{ content | safe }}
  </div>

  {# "Delovi priče": text and photo parts, in the order they were added #}
  {% for section in sections | groupSections %}
    {% if section.type == "text" and section.body %}
    <div class="story-body story-section">
      {{ section.body | renderContent("md") | safe }}
    </div>
    {% elif section.type == "photos" and section.items and section.items.length %}
    <div class="story-photos story-section">
      {% for item in section.items %}{% if item.image %}{{ photo(item, title) }}{% endif %}{% endfor %}
    </div>
    {% endif %}
  {% endfor %}

  {% if gallery and gallery.length %}
  <div class="story-photos">
    {% for item in gallery %}{{ photo(item, title) }}{% endfor %}
  </div>
  {% elif cover and not sections %}
  <div class="story-photos">
    {{ photo({ image: cover }, title) }}
  </div>
  {% endif %}

  {% set next = collections.stories | nextStory(page.url) %}
  {% if next %}
  <a class="next-story" href="{{ next.url }}">
    <span class="next-label">
      <svg width="25" height="12" viewBox="0 0 25 12" fill="none" aria-hidden="true"><path d="M0.75 6H24.25M19 0.75L24.25 6L19 11.25" stroke="#B87734" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {{ home.nextStory }}
    </span>
    <span class="next-title">{{ next.data.title }}</span>
  </a>
  {% endif %}
</article>
