---
layout: layouts/base.njk
---
{# One photo, with the choices made per photo in Pages CMS:
   layout (full, wide, screen, half, small), shape (crop to a ratio), focus (which part stays) and zoom. #}
{% macro photo(item, fallbackAlt) %}
  {% set layout = item.layout or "full" %}
  {% set shape = item.shape or "original" %}
  {% set pos = item.focus | focusPos %}
  {% set zoom = (item.zoom or 1) | float %}
  <figure class="story-photo story-photo--{{ layout }} shape--{{ shape }}">
    <div class="photo-frame"{% if zoom != 1 %} data-zoom="{{ zoom }}" data-focus="{{ pos }}"{% endif %}>
      <img src="{{ item.image }}" alt="{{ item.caption or fallbackAlt }}"
        {% if layout == "screen" %}sizes="100vw"{% elif layout == "wide" %}sizes="(min-width: 1440px) 1090px, 100vw"{% elif layout == "half" %}sizes="(min-width: 820px) 410px, 100vw"{% endif %}
        style="object-position: {{ pos }}">
    </div>
    {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
  </figure>
{% endmacro %}

<article class="story container-narrow">
  <h1 class="story-title">{{ title }}</h1>
  <p class="meta"><span>{{ location }}</span><time datetime="{{ page.date | isoDate }}">{{ page.date | srDate }}</time></p>

  {# Map under the title: the country among its neighbours, its region in gold, a pin from "Koordinate mesta" #}
  {% set map = country | miniMap(coords) %}
  {% if map %}<div class="story-map">{{ map.svg | safe }}</div>{% endif %}

  {# Text, with [foto 1] lines swapped for photos from "Fotografije u tekstu" #}
  {% for part in content | splitPhotos %}
    {% if part.photos %}
    <div class="story-photos story-section">
      {% for n in part.photos %}{% set item = textPhotos[n - 1] if textPhotos else null %}{% if item and item.image %}{{ photo(item, title) }}{% endif %}{% endfor %}
    </div>
    {% else %}
    <div class="story-body">{{ part.html | safe }}</div>
    {% endif %}
  {% endfor %}

  {# "Delovi priče": text and photo parts, in the order they were added #}
  {% for section in sections | groupSections %}
    {% if section.type == "text" and section.body %}
    {% for part in section.body | renderContent("md") | splitPhotos %}
      {% if part.photos %}
      <div class="story-photos story-section">
        {% for n in part.photos %}{% set item = textPhotos[n - 1] if textPhotos else null %}{% if item and item.image %}{{ photo(item, title) }}{% endif %}{% endfor %}
      </div>
      {% else %}
      <div class="story-body story-section{% if section.align and section.align != 'left' %} align--{{ section.align }}{% endif %}">{{ part.html | safe }}</div>
      {% endif %}
    {% endfor %}
    {% elif section.type == "photos" and section.items and section.items.length %}
    <div class="story-photos story-section">
      {% for item in section.items %}{% if item.image %}{{ photo(item, title) }}{% endif %}{% endfor %}
    </div>
    {% endif %}
  {% endfor %}

  {% if gallery and gallery.length %}
  <div class="story-photos">
    {% for item in gallery %}{{ photo(item, title) }}{% endfor %}
  </div>
  {% elif cover and not sections %}
  <div class="story-photos">
    {{ photo({ image: cover }, title) }}
  </div>
  {% endif %}

  {% set next = collections.stories | nextStory(page.url) %}
  {% if next %}
  <a class="next-story" href="{{ next.url }}">
    <span class="next-label">
      <svg width="25" height="12" viewBox="0 0 25 12" fill="none" aria-hidden="true"><path d="M0.75 6H24.25M19 0.75L24.25 6L19 11.25" stroke="#B87734" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {{ home.nextStory }}
    </span>
    <span class="next-title">{{ next.data.title }}</span>
  </a>
  {% endif %}
</article>

<script>
  // "Uvećanje" on a photo: zooms in (125–200%) or out (75%, 50%) inside the photo's frame,
  // towards the chosen "Fokus". When zoomed out, the empty space is filled with a soft,
  // blurred copy of the same photo.
  document.querySelectorAll(".photo-frame[data-zoom]").forEach((frame) => {
    const img = frame.querySelector("img");
    const zoom = parseFloat(frame.dataset.zoom);
    const [fx, fy] = frame.dataset.focus.split(" ").map((v) => parseFloat(v) / 100);
    const keepsOwnShape = frame.closest(".shape--original") && !frame.closest(".story-photo--half");
    let blur;
    const fit = () => {
      const w = img.naturalWidth, h = img.naturalHeight;
      if (!w) return;
      if (keepsOwnShape) frame.style.aspectRatio = `${w} / ${h}`;
      if (zoom < 1 && !blur) {
        blur = new Image();
        blur.src = img.currentSrc || img.src;
        blur.alt = "";
        blur.className = "photo-blur";
        frame.prepend(blur);
      }
      const W = frame.clientWidth, H = frame.clientHeight;
      const scale = Math.max(W / w, H / h) * zoom;
      const iw = w * scale, ih = h * scale;
      Object.assign(img.style, {
        position: "absolute", maxWidth: "none", objectFit: "fill",
        width: `${iw}px`, height: `${ih}px`,
        left: `${(W - iw) * fx}px`, top: `${(H - ih) * fy}px`,
      });
    };
    if (img.complete) fit(); else img.addEventListener("load", fit);
    new ResizeObserver(fit).observe(frame);
  });
</script>
