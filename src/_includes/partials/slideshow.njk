{# Photo slideshow: the big one on the landing page, and the smaller one next to the countries
   on Work with me / Saradnja. Set `slides` (list of { image, alt, focus }) and optionally
   `slideshowClass` and `slideshowLabel` before including. #}
{% if slides and slides.length %}
<section class="hero{% if slideshowClass %} {{ slideshowClass }}{% endif %}" aria-roledescription="carousel" aria-label="{{ slideshowLabel or ('Photos from the road' if english else 'Fotografije sa puta') }}">
  {% for slide in slides %}
  {% set focusY = slide.focus if slide.focus != null else 50 %}
  <div class="hero-slide{% if loop.first %} is-active{% endif %}"{% if not loop.first %} aria-hidden="true"{% endif %}>
    <img class="hero-photo" src="{{ slide.image }}" alt="{{ slide.alt or slide.caption }}" sizes="{{ slideshowSizes or '(min-width: 1440px) 1090px, 90vw' }}" draggable="false"
      {% if loop.first and not slideshowClass %}loading="eager" fetchpriority="high"{% endif %}
      style="object-position: 50% {{ focusY }}%">
  </div>
  {% endfor %}
  {% if slides.length > 1 %}
  <button class="hero-nav hero-nav--prev" type="button" aria-label="{{ 'Previous photo' if english else 'Prethodna fotografija' }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button class="hero-nav hero-nav--next" type="button" aria-label="{{ 'Next photo' if english else 'Sledeća fotografija' }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="hero-dots">
    {% for slide in slides %}
    <button class="hero-dot" type="button" aria-label="{{ 'Photo' if english else 'Fotografija' }} {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>
    {% endfor %}
  </div>
  {% endif %}
</section>

<script>
  // Slideshow: next photo every 5 seconds; the dots jump to a photo; on phones and
  // tablets the photo can be swiped left/right. It pauses while the mouse is over it,
  // while a finger is on it, and while the tab is in the background.
  document.querySelectorAll(".hero:not([data-ready])").forEach((hero) => {
    hero.dataset.ready = "";
    const slides = hero.querySelectorAll(".hero-slide");
    const dots = hero.querySelectorAll(".hero-dot");
    if (slides.length < 2) return;
    let current = 0, timer;
    const show = (i, swipeDir = 0) => {
      const old = slides[current];
      old.classList.remove("is-active");
      old.setAttribute("aria-hidden", "true");
      // swipe or side click: the old photo slides out one way while the new one slides in from the other
      old.style.transform = swipeDir ? `translateX(${swipeDir * 35}%)` : "";
      setTimeout(() => { if (!old.classList.contains("is-active")) old.style.transform = ""; }, 1200);
      dots[current].removeAttribute("aria-current");
      current = (i + slides.length) % slides.length;
      const next = slides[current];
      if (swipeDir) {
        next.classList.add("is-dragging"); // place it at the side without animating
        next.style.transform = `translateX(${-swipeDir * 35}%)`;
        next.offsetWidth;
        next.classList.remove("is-dragging");
      }
      next.classList.add("is-active");
      next.removeAttribute("aria-hidden");
      next.style.transform = "";
      dots[current].setAttribute("aria-current", "true");
    };
    const start = () => { clearInterval(timer); timer = setInterval(() => show(current + 1), 5000); };
    const stop = () => clearInterval(timer);
    dots.forEach((dot, i) => dot.addEventListener("click", () => { show(i); start(); }));
    // clicking/tapping the left or right part of the photo: it slides out that way like a swipe
    let swipedJustNow = false;
    hero.querySelector(".hero-nav--prev").addEventListener("click", () => {
      if (swipedJustNow) return;
      show(current - 1, 1); start();
    });
    hero.querySelector(".hero-nav--next").addEventListener("click", () => {
      if (swipedJustNow) return;
      show(current + 1, -1); start();
    });
    hero.addEventListener("mouseenter", stop);
    hero.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));

    // Swipe: the photo follows the finger; a swipe of 50px or more changes the photo.
    let startX = null, startY = 0, dx = 0, dragging = false;
    hero.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      startX = e.clientX; startY = e.clientY; dx = 0; dragging = false;
      stop();
    });
    hero.addEventListener("pointermove", (e) => {
      if (startX === null) return;
      dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(e.clientY - startY)) dragging = true;
      if (dragging) {
        slides[current].classList.add("is-dragging");
        slides[current].style.transform = `translateX(${dx}px)`;
      }
    });
    const end = () => {
      if (startX === null) return;
      slides[current].classList.remove("is-dragging");
      if (dragging && Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1), dx < 0 ? -1 : 1);
      else slides[current].style.transform = "";
      // a swipe that ends over a side button must not also count as a tap on it
      if (dragging) { swipedJustNow = true; setTimeout(() => (swipedJustNow = false), 300); }
      startX = null;
      start();
    };
    hero.addEventListener("pointerup", end);
    hero.addEventListener("pointercancel", end);
    start();
  });
</script>
{% endif %}
