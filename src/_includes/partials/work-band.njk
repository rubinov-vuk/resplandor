{# Green band across the whole screen, leading agencies to Work with me / Saradnja. Needs `band` {title, text, link, url}. #}
<section class="en-work-band">
  <div class="en-work-band-inner">
    <p class="en-work-title">{{ band.title }}</p>
    <p>{{ band.text }}</p>
    <a class="en-button en-button--outline-light" href="{{ band.url }}">{{ band.link }}
      <svg width="25" height="12" viewBox="0 0 25 12" fill="none" aria-hidden="true"><path d="M0.75 6H24.25M19 0.75L24.25 6L19 11.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>
