<header class="site-header">
  <a class="logo" href="{{ '/en/' if english else '/' }}" aria-label="{{ site.title }} — {{ 'home' if english else 'početna' }}">RESPLAND<span class="logo-sun">O</span>R</a>
  <span class="header-line" aria-hidden="true"></span>
  {% if showEnglish %}
  {# Page links sit on the gold line like a label; SR · EN sits under the line, at the edge of the photos and text #}
  {% set storiesUrl = "/en/" if english else "/" %}
  {% set workUrl = "/en/work-with-me/" if english else "/saradnja/" %}
  <nav class="header-nav" aria-label="{{ 'Pages' if english else 'Strane' }}">
    <a href="{{ storiesUrl }}"{% if page.url == storiesUrl %} aria-current="page"{% endif %}>{{ "Stories" if english else "Priče" }}</a>
    <a href="{{ workUrl }}"{% if page.url == workUrl %} aria-current="page"{% endif %}>{{ "Work with me" if english else "Saradnja" }}</a>
  </nav>
  <p class="header-lang">
    {% if english %}<a href="{{ altUrl or '/' }}" lang="sr" hreflang="sr">SR</a><span aria-hidden="true">·</span><b aria-current="true">EN</b>
    {% else %}<b aria-current="true">SR</b><span aria-hidden="true">·</span><a href="{{ altUrl or '/en/' }}" lang="en" hreflang="en">EN</a>{% endif %}
  </p>
  {% endif %}
</header>
